    },
    "shadow-2": {
      "$value": "0 1px 2px rgba(12, 21, 20, 0.04), 0 8px 24px rgba(12, 21, 20, 0.06)"
    },
    "shadow-3": {
      "$value": "0 2px 6px rgba(12, 21, 20, 0.05), 0 24px 60px rgba(12, 21, 20, 0.12)"
    }
