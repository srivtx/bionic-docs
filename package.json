{
  "name": "bionic-docs",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Read PDFs and EPUBs with bionic fixation emphasis, entirely on-device. Chrome + Firefox MV3.",
  "scripts": {
    "build": "node build.mjs",
    "build:chrome": "node build.mjs chrome",
    "build:firefox": "node build.mjs firefox",
    "build:watch": "node build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "icons": "node scripts/make-icons.mjs",
    "verify": "node scripts/verify-build.mjs",
    "e2e": "bun scripts/e2e.mjs",
    "make-fixtures": "bun scripts/make-fixtures.ts",
    "package": "node scripts/package.mjs",
    "lint:firefox": "web-ext lint --source-dir dist/firefox",
    "demo": "node scripts/build-demo.mjs",
    "og": "node scripts/make-og.mjs",
    "stamp": "node scripts/stamp-assets.mjs",
    "check-copy": "node scripts/check-copy.mjs",
    "e2e:site": "node scripts/e2e-site.mjs",
    "check-site": "node scripts/check-site.mjs",
    "site": "node scripts/build-demo.mjs && node scripts/make-og.mjs && node scripts/stamp-assets.mjs && node scripts/check-site.mjs && node scripts/check-copy.mjs"
  },
  "dependencies": {
    "fflate": "^0.8.2",
    "pdfjs-dist": "^4.8.69"
  },
  "devDependencies": {
    "@types/bun": "^1.1.14",
    "@types/chrome": "^0.0.302",
    "esbuild": "^0.25.0",
    "linkedom": "^0.18.5",
    "typescript": "^5.7.2"
  }
}
